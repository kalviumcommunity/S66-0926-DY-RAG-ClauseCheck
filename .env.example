# LLM providers (keys stay empty here; put real values in your local .env)
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.3-70b-versatile

# LLM client timeout and retries
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_RETRY_WAIT_SECONDS=1.0
GEN_TEMPERATURE=0.0
CONTEXT_TOKEN_BUDGET=3000
RELEVANCE_THRESHOLD=0.0

# Sessions, cache and query log (PR 12)
HISTORY_TURNS=3
CACHE_TTL_SECONDS=86400

# Logging
LOG_LEVEL=INFO

# Embeddings: gemini or local. Vectors from different models are never mixed, so changing
# the provider or model means rebuilding the index (python -m clausecheck.ingest --rebuild)
EMBED_PROVIDER=gemini
EMBED_MODEL=text-embedding-004
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH=32
INDEX_VERSION=v1
TOP_K=5

# Retrieval: RRF constant, candidates per retriever, re-ranker and supplier name matching (0-100)
RRF_K=60
VECTOR_K=20
BM25_K=20
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
RERANK_TOP_N=5
SUPPLIER_MATCH_MIN=85

# Chunking: token cap per chunk, and window size and overlap for longer clauses
CHUNK_MAX_TOKENS=512
CHUNK_WINDOW=400
CHUNK_OVERLAP=60

# Corpus sourcing (SEC requires a contact email in the user agent)
EDGAR_USER_AGENT=
RAW_DATA_DIR=data/raw

# Storage paths
DATA_DIR=data
INDEX_DIR=index
SQLITE_PATH=index/clausecheck.db

# API (PR 15)
FRONTEND_ORIGIN=http://localhost:8501
PORT=7860
